FROM ros:jazzy-ros-base
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ros-jazzy-clearpath-simulator ros-jazzy-ros-gz \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ros-jazzy-nav2-planner ros-jazzy-nav2-controller ros-jazzy-nav2-navfn-planner \
    ros-jazzy-nav2-regulated-pure-pursuit-controller ros-jazzy-nav2-behaviors \
    ros-jazzy-nav2-bt-navigator ros-jazzy-nav2-map-server ros-jazzy-nav2-lifecycle-manager \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /project
CMD ["bash", "/project/scripts/start_husky.sh"]
